# Node Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Connection (MySQL 8.x)
# In local development using unix socket:
# DATABASE_URL="mysql://root@localhost/sekhon_farm?socket=/tmp/mysql-run/mysqld.sock"
# Or standard TCP:
DATABASE_URL="mysql://root:password@127.0.0.1:3306/sekhon_farm"

# Session & Security
# Generate secure 64-character hex strings: openssl rand -hex 32
SESSION_SECRET=change-this-in-production-session-secret-at-least-32-chars-long
COOKIE_SECRET=change-this-in-production-cookie-secret-at-least-32-chars-long
SESSION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=15

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

# Initial Admin Seed Credentials (never commit real credentials)
INITIAL_ADMIN_NAME="Sekhon Admin"
INITIAL_ADMIN_EMAIL=admin@sekhonfarm.com
INITIAL_ADMIN_PHONE="+1 (555) 019-2834"
INITIAL_ADMIN_PASSWORD="Admin@Sekhon2026!#"

# Initial Test User Seed Credentials (for testing deployment verification)
INITIAL_TEST_USER_NAME="Test Patron"
INITIAL_TEST_USER_EMAIL=test@sekhonfarm.com
INITIAL_TEST_USER_PHONE="+1 (555) 789-0123"
INITIAL_TEST_USER_PASSWORD="Test@Sekhon2026!#"

